{
  "name": "marinara-hours",
  "private": true,
  "type": "module",
  "description": "Marinara Hours time clock. The app is index.html (GitHub Pages); the backend lives in supabase/.",
  "scripts": {
    "test": "node --test --test-reporter=spec tests/edge/observe.test.mjs",
    "test:db": "bash tests/db/run.sh supabase/migrations/20261012080000_pin_match_count.sql",
    "test:e2e": "node tests/e2e/login-clock.e2e.mjs",
    "test:integration": "node tests/integration/run.mjs",
    "test:hardening": "node tests/integration/hardening.mjs",
    "test:e2e:v38": "node tests/e2e/v38.e2e.mjs",
    "test:e2e:v38:webkit": "E2E_BROWSER=webkit node tests/e2e/v38.e2e.mjs",
    "test:pdf": "node --test tests/e2e/pdf-regression.test.mjs && node tests/e2e/pdf.e2e.mjs && node tests/e2e/pdf-seven.e2e.mjs",
    "test:pdf:webkit": "E2E_BROWSER=webkit node tests/e2e/pdf.e2e.mjs && E2E_BROWSER=webkit node tests/e2e/pdf-seven.e2e.mjs",
    "test:visa": "node --test --test-reporter=spec tests/edge/visa-hours.test.mjs tests/edge/roster-hours.test.mjs tests/edge/invoice-reader.test.mjs",
    "test:features": "node tests/integration/features.mjs",
    "test:stock": "node tests/integration/stock.mjs",
    "test:e2e:stock": "node tests/e2e/stock.e2e.mjs",
    "test:e2e:stock:webkit": "E2E_BROWSER=webkit node tests/e2e/stock.e2e.mjs",
    "test:roles": "node tests/integration/roles.mjs",
    "test:e2e:roles": "node tests/e2e/roles.e2e.mjs",
    "test:e2e:roles:webkit": "E2E_BROWSER=webkit node tests/e2e/roles.e2e.mjs",
    "test:recipes": "node tests/integration/recipes.mjs",
    "test:e2e:recipes": "node tests/e2e/recipes.e2e.mjs",
    "test:e2e:recipes:webkit": "E2E_BROWSER=webkit node tests/e2e/recipes.e2e.mjs",
    "test:invoices": "node tests/integration/invoices.mjs",
    "test:ingredient-costs": "node tests/integration/ingredient-costs.mjs",
    "test:price-book": "node tests/integration/price-book.mjs",
    "test:permissions": "node tests/integration/permissions.mjs",
    "test:shopping": "node tests/integration/shopping.mjs",
    "test:own-pin": "node tests/integration/own-pin.mjs",
    "test:top-products": "node tests/integration/top-products.mjs",
    "test:maintenance": "node tests/integration/maintenance.mjs",
    "test:photos-contacts": "node tests/integration/photos-contacts.mjs",
    "test:e2e:invoices": "node tests/e2e/invoices.e2e.mjs",
    "test:e2e:invoices:webkit": "E2E_BROWSER=webkit node tests/e2e/invoices.e2e.mjs",
    "test:e2e:redesign": "node tests/e2e/redesign.e2e.mjs && node tests/e2e/request-timeout.e2e.mjs",
    "test:e2e:redesign:webkit": "E2E_BROWSER=webkit node tests/e2e/redesign.e2e.mjs",
    "test:e2e:update": "node tests/e2e/update-check.e2e.mjs",
    "test:e2e:top-products": "node tests/e2e/top-products.e2e.mjs",
    "test:e2e:top-products:webkit": "E2E_BROWSER=webkit node tests/e2e/top-products.e2e.mjs",
    "test:e2e:own-pin": "node tests/e2e/own-pin.e2e.mjs",
    "test:e2e:own-pin:webkit": "E2E_BROWSER=webkit node tests/e2e/own-pin.e2e.mjs",
    "test:e2e:shopping": "node tests/e2e/shopping.e2e.mjs",
    "test:e2e:shopping:webkit": "E2E_BROWSER=webkit node tests/e2e/shopping.e2e.mjs",
    "test:e2e:maintenance": "node tests/e2e/maintenance.e2e.mjs",
    "test:e2e:maintenance:webkit": "E2E_BROWSER=webkit node tests/e2e/maintenance.e2e.mjs",
    "test:e2e:update:webkit": "E2E_BROWSER=webkit node tests/e2e/update-check.e2e.mjs",
    "test:push": "node --test --test-reporter=spec tests/edge/webpush.test.mjs && node tests/integration/push.mjs && node tests/integration/push-badge.mjs"
  },
  "devDependencies": {
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "playwright": "1.56.1",
    "typescript": "5.9.3"
  }
}
